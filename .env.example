# Local Development Environment Configuration Example
APP_ENV=development

# Database Configuration (PostgreSQL in Docker, SQLite/Postgres for local dev)
DATABASE_URL=postgresql://chatbot_user:development_only_password@postgres:5432/chatbot_db

# Redis Infrastructure Configuration
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# Authentication & JWT Security
JWT_SECRET_KEY=change_this_to_a_secure_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:8000,http://localhost

# Free/Local AI LLM Integration (NVIDIA API / Local Model Endpoint)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# RAG Configuration
RAG_ENABLED=true
RAG_TOP_K=5
RAG_RELEVANCE_THRESHOLD=1.0
CHUNK_SIZE=500
CHUNK_OVERLAP=100
